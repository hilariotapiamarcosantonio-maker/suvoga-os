SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
NEXT_PUBLIC_SITE_URL=https://suvoga-os-tjaa.vercel.app
# Legacy alias still read for older local setups. Prefer NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRM_BASIC_AUTH_USER=
CRM_BASIC_AUTH_PASSWORD=

# Email notification workflow. Keep secrets out of the repository.
# Supported provider today: resend. Leave disabled until credentials and sender
# are verified.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_NOTIFICATION_TO=asnamatem@gmail.com

# Official public contact channels live in src/lib/suvoga-contact.ts and work
# in production without any env var. These overrides are optional (e.g. for a
# staging number/email). Leave empty to use the official approved values.
# Number: digits only or with punctuation, include country code (e.g. 18298389185).
NEXT_PUBLIC_SUVOGA_WHATSAPP=
NEXT_PUBLIC_SUVOGA_EMAIL=
# Optional: overrides the default prefilled message for the generic (non-course) button.
NEXT_PUBLIC_SUVOGA_WHATSAPP_MESSAGE=
